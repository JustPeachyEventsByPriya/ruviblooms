# Set the business URLs in .env.local to enable the floating links.
VITE_WHATSAPP_URL=
VITE_INSTAGRAM_URL=

# Local email mode: capture writes .eml files, smtp delivers real email.
RENTAL_MAIL_MODE=capture
RENTAL_SMTP_HOST=
RENTAL_SMTP_PORT=587
RENTAL_SMTP_USER=
RENTAL_SMTP_PASSWORD=
RENTAL_MAIL_FROM=

# Optional Web3Forms public form key. When set, it takes precedence over local mail mode.
VITE_WEB3FORMS_ACCESS_KEY=
