# Optional. Leaving either Shopify value unset uses the local mock catalog.
# Shopify Headless channel hostname (without https://) and PUBLIC Storefront API access token.
# Keep real values in .env. This app does not use Shopify Admin or private API tokens.
# PUBLIC_STORE_DOMAIN=your-store.myshopify.com
# PUBLIC_STOREFRONT_API_TOKEN=your-public-storefront-access-token

# Optional port for the local production preview (npm start).
# PORT=3000
